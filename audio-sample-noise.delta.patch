-    const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
-    if (command_line->HasSwitch(switches::kFingerprint)) {
-        std::string fingerprint_str = command_line->GetSwitchValueASCII(switches::kFingerprint);
-        if (!fingerprint_str.empty()) {
-            std::string combined = fingerprint_str + std::to_string(static_cast<int>(sample_rate)) + "samplerate";
-            uint32_t hash = std::hash<std::string>{}(combined);
-            // 生成 ±0.01 范围的噪声
-            float noise = ((static_cast<float>(hash % 10000) / 10000.0f) - 0.5f) * 0.02f;
-            return noise;
-        }
+  const uint64_t key = std::hash<std::string>{}(fingerprint_str + "audio-samples");
+  for (unsigned channel = 0; channel < buffer->numberOfChannels(); ++channel) {
+    DOMFloat32Array* data = buffer->getChannelData(channel).Get();
+    if (!data) {
+      continue;
     }
-    return 0.0f;
+    base::span<float> samples = data->AsSpan();
+    for (size_t i = 0; i < samples.size(); ++i) {
+      // splitmix64 over (key, channel, index)
+      uint64_t z = key ^ (static_cast<uint64_t>(channel) << 48) ^ i;
+      z += 0x9e3779b97f4a7c15ULL;
+      z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+      z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+      z ^= z >> 31;
+      const double magnitude =
+          0.5 + (static_cast<double>(z >> 11) / 9007199254740992.0) * 0.5;
+      const double factor = 1.0 + ((z & 1) ? magnitude : -magnitude) * 1e-6;
+      samples[i] = static_cast<float>(samples[i] * factor);
+    }
+  }
