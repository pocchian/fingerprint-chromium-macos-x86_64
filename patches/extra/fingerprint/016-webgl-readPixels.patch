@@ -5368,6 +5373,67 @@ void WebGLRenderingContextBase::ReadPixelsHelper(GLint x,
       return;
     }
     ContextGL()->ReadPixels(x, y, width, height, format, type, data);
+
+    // Fingerprint canvas noise for readPixels. Only RGBA/UNSIGNED_BYTE reads
+    // whose row stride is exactly 4 * width are touched (other formats use 1-2
+    // bytes or 16-bit components per pixel). The noise runs on a tight copy of
+    // the part of the read that overlaps the framebuffer. On the default
+    // framebuffer the copy is top-down and keyed by canvas coordinates, so it
+    // matches the 2D noise of the same pixels. Texture-backed framebuffers are
+    // skipped because their size isn't tracked.
+    const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+    if (format == GL_RGBA && type == GL_UNSIGNED_BYTE && data && width > 0 &&
+        height > 0 && pack_alignment_ > 0 &&
+        (4 * static_cast<int64_t>(width)) % pack_alignment_ == 0 &&
+        command_line->HasSwitch(switches::kFingerprint) &&
+        (!command_line->HasSwitch(switches::kDisableSpoofing) ||
+         command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("canvas") == std::string::npos)) {
+      int64_t fb_width = -1;
+      int64_t fb_height = -1;
+      if (!framebuffer) {
+        fb_width = drawingBufferWidth();
+        fb_height = drawingBufferHeight();
+      } else if (WebGLObject* attachment = framebuffer->GetAttachmentObject(
+                     framebuffer->GetReadBuffer());
+                 attachment && attachment->IsRenderbuffer()) {
+        auto* renderbuffer = static_cast<WebGLRenderbuffer*>(attachment);
+        fb_width = renderbuffer->Width();
+        fb_height = renderbuffer->Height();
+      }
+      const int64_t x0 = std::max<int64_t>(x, 0);
+      const int64_t y0 = std::max<int64_t>(y, 0);
+      const int64_t ow =
+          std::min<int64_t>(static_cast<int64_t>(x) + width, fb_width) - x0;
+      const int64_t oh =
+          std::min<int64_t>(static_cast<int64_t>(y) + height, fb_height) - y0;
+      if (fb_width > 0 && fb_height > 0 && ow >= 8 && oh >= 8) {
+        const bool flip = !framebuffer;
+        const size_t src_stride = 4 * static_cast<size_t>(width);
+        const size_t dst_stride = 4 * static_cast<size_t>(ow);
+        const size_t src_col = 4 * static_cast<size_t>(x0 - x);
+        std::vector<uint8_t> overlap(dst_stride * static_cast<size_t>(oh));
+        for (int64_t r = 0; r < oh; ++r) {
+          const int64_t gl_row = flip ? y0 + oh - 1 - r : y0 + r;
+          std::copy_n(data + static_cast<size_t>(gl_row - y) * src_stride +
+                          src_col,
+                      dst_stride,
+                      overlap.data() + static_cast<size_t>(r) * dst_stride);
+        }
+        const SkImageInfo overlap_info = SkImageInfo::Make(
+            static_cast<int>(ow), static_cast<int>(oh), kRGBA_8888_SkColorType,
+            kUnpremul_SkAlphaType);
+        StaticBitmapImage::ShuffleSubchannelColorData(
+            overlap.data(), overlap_info, static_cast<int>(x0),
+            static_cast<int>(flip ? fb_height - y0 - oh : y0));
+        for (int64_t r = 0; r < oh; ++r) {
+          const int64_t gl_row = flip ? y0 + oh - 1 - r : y0 + r;
+          std::copy_n(overlap.data() + static_cast<size_t>(r) * dst_stride,
+                      dst_stride,
+                      data + static_cast<size_t>(gl_row - y) * src_stride +
+                          src_col);
+        }
+      }
+    }
   }
