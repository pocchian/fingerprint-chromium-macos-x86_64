+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -4,11 +4,40 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
+#include <functional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/system/sys_info.h"
+#include "components/ungoogled/ungoogled_switches.h"
 
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+
+  // Invalid or out-of-range values are treated as if the switch were absent
+  // (std::stoul would abort the renderer on non-numeric input).
+  unsigned custom_concurrency = 0;
+  if (command_line->HasSwitch(switches::kFingerprintHardwareConcurrency) &&
+      base::StringToUint(command_line->GetSwitchValueASCII(
+                             switches::kFingerprintHardwareConcurrency),
+                         &custom_concurrency) &&
+      custom_concurrency >= 1 && custom_concurrency <= 256) {
+    return custom_concurrency;
+  }
+
+  if (command_line->HasSwitch(switches::kFingerprint)) {
+    std::string fingerprint_str = command_line->GetSwitchValueASCII(switches::kFingerprint);
+    uint64_t parsed = 0;
+    uint32_t fingerprint =
+        base::StringToUint64(fingerprint_str, &parsed)
+            ? static_cast<uint32_t>(parsed)
+            : static_cast<uint32_t>(std::hash<std::string>{}(fingerprint_str));
+    return static_cast<unsigned>(((fingerprint % 13) + 4) * 2);
+  }
+
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
