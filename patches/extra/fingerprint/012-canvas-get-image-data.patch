+// Fingerprint canvas noise for toBlob/convertToBlob: returns a noised copy of
+// |image|, made the same way as in HTMLCanvasElement::ToDataURLInternal (8-bit
+// sources only, colour space and opaque alpha kept). Returns |image| unchanged
+// when noise is off, for other colour types, or on any failure.
+scoped_refptr<StaticBitmapImage> MaybeApplyFingerprintCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint) ||
+      (command_line->HasSwitch(switches::kDisableSpoofing) &&
+       command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+               .find("canvas") != std::string::npos)) {
+    return image;
+  }
+  PaintImage paint_image = image->PaintImageForCurrentFrame();
+  const SkImageInfo src_info = paint_image.GetSkImageInfo();
+  if (src_info.colorType() != kRGBA_8888_SkColorType &&
+      src_info.colorType() != kBGRA_8888_SkColorType) {
+    return image;
+  }
+  const SkImageInfo info =
+      src_info.makeColorType(kRGBA_8888_SkColorType)
+          .makeAlphaType(src_info.alphaType() == kOpaque_SkAlphaType
+                             ? kOpaque_SkAlphaType
+                             : kUnpremul_SkAlphaType);
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeMinByteSize();
+  if (size == 0 || SkImageInfo::ByteSizeOverflowed(size) ||
+      size > partition_alloc::MaxDirectMapped()) {
+    return image;
+  }
+  sk_sp<SkData> data = SkData::MakeUninitialized(size);
+  if (!data ||
+      !paint_image.readPixels(info, data->writable_data(), row_bytes, 0, 0)) {
+    return image;
+  }
+  StaticBitmapImage::ShuffleSubchannelColorData(data->writable_data(), info, 0,
+                                                0);
+  sk_sp<SkImage> noised =
+      SkImages::RasterFromData(info, std::move(data), row_bytes);
+  if (!noised) {
+    return image;
+  }
+  return UnacceleratedStaticBitmapImage::Create(std::move(noised),
+                                                image->Orientation());
+}
+
 }  // anonymous namespace
 
