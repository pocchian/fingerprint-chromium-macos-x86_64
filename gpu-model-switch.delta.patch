+// Returns the chip name from --fingerprint-gpu-model (e.g. "M5", "A18 Pro"),
+// or "" if the switch is unset or the value isn't a plain model name.
+std::string GetMacosGpuModelOverride(const base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(switches::kFingerprintGpuModel)) {
+    return "";
+  }
+  std::string model(base::TrimWhitespaceASCII(
+      command_line.GetSwitchValueASCII(switches::kFingerprintGpuModel),
+      base::TRIM_ALL));
+  if (base::StartsWith(model, "Apple ")) {
+    model = model.substr(6);
+  }
+  if (model.empty() || model.size() > 24) {
+    return "";
+  }
+  for (char c : model) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != ' ') {
+      return "";
+    }
+  }
+  return model;
+}
